# PostgreSQL local. Nunca versionar credenciais reais.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/msgriffe?schema=public
POSTGRES_PORT=5433

# Ambiente e rede. Em produção, Railway Secrets fornece estes valores.
NODE_ENV=development
PORT=3000
HOST=127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Trocar por segredo aleatório antes de qualquer ambiente compartilhado.
ACCESS_TOKEN_SECRET=local-development-only-secret-with-32-characters
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_SESSION_TTL_DAYS=14
SESSION_COOKIE_SAME_SITE=lax
SESSION_COOKIE_SECURE=false
